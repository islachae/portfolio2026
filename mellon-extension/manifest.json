{
  "manifest_version": 3,
  "name": "Mellon",
  "version": "0.3.0",
  "description": "Reads your recent email and sorts it into a priority list of Updates.",
  "key": "",
  "action": {
    "default_title": "Open Mellon"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "permissions": [
    "sidePanel",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://api.anthropic.com/*"
  ]
}
