{
  "manifest_version": 3,
  "name": "Mellon",
  "version": "0.5.0",
  "description": "Reads your recent email and sorts it into a priority list of Updates.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Mellon",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "permissions": [
    "sidePanel",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://api.anthropic.com/*"
  ]
}
