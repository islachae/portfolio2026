{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "functions": {
    "api/pebbo.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(work|about|fun|emoji)/(.*)\\.(webp|svg|png|jpg|mp4|webm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/#about/story",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/#about/story",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#hi",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/#hi",
      "permanent": true
    },
    {
      "source": "/case-studies/tipping",
      "destination": "/#case/tipping",
      "permanent": true
    },
    {
      "source": "/case-studies/tipping/",
      "destination": "/#case/tipping",
      "permanent": true
    },
    {
      "source": "/case-studies/pebbo",
      "destination": "/#case/pebbo",
      "permanent": true
    },
    {
      "source": "/case-studies/pebbo/",
      "destination": "/#case/pebbo",
      "permanent": true
    },
    {
      "source": "/case-studies/zipflow",
      "destination": "/#zipflow",
      "permanent": false
    },
    {
      "source": "/case-studies/zipflow/",
      "destination": "/#zipflow",
      "permanent": false
    },
    {
      "source": "/case-studies",
      "destination": "/#tipping",
      "permanent": false
    },
    {
      "source": "/design-system",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/design-system/",
      "destination": "/",
      "permanent": false
    }
  ]
}
